      "id": "673f32bc-c7f7-41ab-bc92-563ad20e5491",
      "name": "Get Portfolio Ledger",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        896,
        320
      ]

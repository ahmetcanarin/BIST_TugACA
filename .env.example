# =============================================================================
# BIST 100 — Ortam Değişkenleri (.env) Şablonu
# =============================================================================

# Telegram Bot Yapılandırması (BotFather'dan alınan token)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# n8n Yapılandırması
N8N_PORT=5678
N8N_HOST=localhost
WEBHOOK_URL=https://your-custom-domain.ngrok-free.dev/
GENERIC_TIMEZONE=Europe/Istanbul

# Ngrok Kalıcı HTTPS Tünel Yapılandırması
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
NGROK_DOMAIN=your-custom-domain.ngrok-free.dev

# n8n AI Agent için opsiyonel LLM Anahtarları
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# API Sunucusu Ayarları
API_PORT=5050
STREAMLIT_PORT=8501
